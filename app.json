{
  "expo": {
    "name": "JWP",
    "slug": "jwp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jwp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jungnguyen.jwp"
    },
    "android": {
      "package": "com.jungnguyen.jwp",
      "adaptiveIcon": {
        "backgroundColor": "#6B4AF1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6FA",
          "dark": {
            "backgroundColor": "#060A12"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#5B5BD6"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "extraProguardRules": "-keep class com.google.mlkit.vision.text.** { *; }\n-keep class expo.modules.jwpocr.** { *; }\n-dontwarn com.google.mlkit.vision.text.**\n"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "vi",
            "en"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "JwpToday",
              "label": "JWP · Hôm nay",
              "description": "Hôm nay được tiêu bao nhiêu, nút thêm nhanh",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "JwpBudgets",
              "label": "JWP · Ngân sách",
              "description": "Các ngân sách sát hạn mức nhất",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ddeeccf7-6965-4015-a54a-591ce3e12dbf"
      }
    }
  }
}
